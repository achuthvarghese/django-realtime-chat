# Copy to .env and adjust. All values are optional in development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Use Redis for the channel layer (required with more than one server process)
# REDIS_URL=redis://localhost:6379/0
# SQLite file location (defaults to ./db.sqlite3)
# SQLITE_PATH=/data/db.sqlite3
# Demo data for `manage.py seed_demo --if-debug` (debug only; see docs/demo-data.md)
DJANGO_SEED_DEMO=true
